{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "Client: Lorélie",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}/app",
            "presentation": {
                "hidden": false,
                "group": "Nuxt",
                "order": 1
            }
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Server: Lorélie",
            "outputCapture": "std",
            "program": "${workspaceFolder}/node_modules/nuxt/bin/nuxt.mjs",
            "args": [
                "dev"
            ],
            "presentation": {
                "hidden": false,
                "group": "Nuxt",
                "order": 1
            }
        }
    ],
    "compounds": [
        {
            "name": "Fullstack: Lorélie",
            "configurations": [
                "Server: Lorélie",
                "Client: Lorélie"
            ]
        }
    ]
}
